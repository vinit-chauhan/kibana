{
    "type": "plugin",
    "id": "@kbn/bootcamp-plugin",
    "owner": [
        "@elastic/integration-experience"
    ],
    "group": "platform",
    "visibility": "shared",
    "description": "Bootcamp plugin for the Elastic Bootcamp",
    "plugin": {
        "id": "bootcamp",
        "server": true,
        "browser": true,
        "configPath":["xpack", "bootcamp"],
        "optionalPlugins": ["features"],
        "requiredBundles": ["kibanaReact"],
        "requiredPlugins": ["share"],
  }
}